{
  "name": "context-receipts",
  "version": "0.2.0",
  "private": true,
  "description": "Experimental schema-backed Context Receipt reference helpers",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "SCHEMA-LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/generate-schemas.cjs && tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.types.json && node --test test/*.test.cjs",
    "prepack": "npm run build",
    "test:pack": "node scripts/pack-smoke.cjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-ts": "3.1.1"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "typescript": "7.0.2"
  }
}
