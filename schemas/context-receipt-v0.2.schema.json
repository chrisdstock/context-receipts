{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/chrisdstock/context-receipts/main/schemas/context-receipt-v0.2.schema.json",
  "title": "Context Receipt v0.2 draft",
  "type": "object",
  "properties": {
    "context_receipt": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.2"
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "type": {
              "type": "string",
              "enum": [
                "app",
                "api",
                "tool",
                "retriever",
                "memory",
                "guardrail",
                "human",
                "other"
              ]
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "name",
            "type"
          ],
          "additionalProperties": false
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "audience": {
          "type": "string",
          "enum": [
            "model",
            "user",
            "developer",
            "audit"
          ]
        },
        "assurance": {
          "type": "string",
          "enum": [
            "self_reported",
            "boundary_observed"
          ]
        },
        "binding": {
          "type": "object",
          "properties": {
            "packet_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "boundary": {
              "type": "string",
              "enum": [
                "tool_output",
                "model_input"
              ]
            },
            "parent_receipt_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "packet_id",
            "revision",
            "boundary",
            "parent_receipt_ids"
          ],
          "additionalProperties": false
        },
        "included_context": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "disclosed"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "category": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "source_ref": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "provenance": {
                        "type": "string",
                        "enum": [
                          "user_provided",
                          "retrieved",
                          "inferred",
                          "generated",
                          "memory",
                          "tool_output",
                          "other"
                        ]
                      }
                    },
                    "required": [
                      "category"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "state",
                "items"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "none",
                    "unknown",
                    "withheld"
                  ]
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            }
          ]
        },
        "excluded_context": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "disclosed"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "category": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "stage": {
                        "type": "string",
                        "enum": [
                          "not_searched",
                          "filtered",
                          "ranked_not_selected",
                          "delivery_omission"
                        ]
                      },
                      "reason": {
                        "type": "string",
                        "enum": [
                          "privacy",
                          "permission",
                          "relevance",
                          "safety",
                          "cost",
                          "unavailable",
                          "policy",
                          "user_choice",
                          "other"
                        ]
                      }
                    },
                    "required": [
                      "category",
                      "stage",
                      "reason"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "state",
                "items"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "none",
                    "unknown",
                    "withheld"
                  ]
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            }
          ]
        },
        "transformations": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "disclosed"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "summarized",
                          "redacted",
                          "translated",
                          "ranked",
                          "compressed",
                          "anonymized",
                          "paraphrased",
                          "filtered",
                          "normalized",
                          "chunked",
                          "other"
                        ]
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "type",
                      "description"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "state",
                "items"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "none",
                    "unknown",
                    "withheld"
                  ]
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            }
          ]
        },
        "permission_basis": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "disclosed"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "basis": {
                        "type": "string",
                        "enum": [
                          "user_prompt",
                          "explicit_user_permission",
                          "user_setting",
                          "enterprise_policy",
                          "public_data",
                          "other"
                        ]
                      },
                      "scope": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "evidence_ref": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "basis",
                      "scope"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "state",
                "items"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "none",
                    "unknown",
                    "withheld"
                  ]
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            }
          ]
        },
        "coverage": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "full",
                    "partial"
                  ]
                },
                "scope": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "status",
                "scope"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "const": "unknown"
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": false
            }
          ]
        },
        "freshness": {
          "type": "string",
          "enum": [
            "current",
            "stale",
            "unknown"
          ]
        },
        "constraints": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "disclosed"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "instruction",
                          "safety",
                          "privacy",
                          "domain",
                          "legal",
                          "output_format",
                          "other"
                        ]
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "type",
                      "description"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "state",
                "items"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "none",
                    "unknown",
                    "withheld"
                  ]
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            }
          ]
        },
        "challenge_path": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "disclosed"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "request_more_context",
                          "request_raw_source",
                          "request_user_clarification",
                          "escalate_to_human"
                        ]
                      },
                      "scope": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "authorization": {
                        "type": "string",
                        "enum": [
                          "existing_scope",
                          "additional_authorization_required"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "type",
                      "scope",
                      "authorization"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "state",
                "items"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "none",
                    "unknown",
                    "withheld"
                  ]
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            }
          ]
        },
        "audit": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "disclosed"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "reference": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "retention": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "reference",
                      "retention"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "state",
                "items"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "none",
                    "unknown",
                    "withheld"
                  ]
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            }
          ]
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$"
          },
          "additionalProperties": {
            "type": "object"
          }
        }
      },
      "required": [
        "schema_version",
        "receipt_id",
        "timestamp",
        "source",
        "purpose",
        "audience",
        "assurance",
        "binding",
        "included_context",
        "excluded_context",
        "transformations",
        "permission_basis",
        "coverage",
        "freshness",
        "constraints",
        "challenge_path",
        "audit"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "coverage": {
                "properties": {
                  "status": {
                    "const": "full"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "included_context": {
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "disclosed",
                      "none"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "context_receipt"
  ],
  "additionalProperties": false
}
